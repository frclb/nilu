<?xml version="1.0" encoding="utf-8"?>
<!-- Orta widget (4×2): solda halka ve değer, sağda etiket ve satırlar —
     iOS'taki orta boyla aynı. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:theme="@style/NiluWidget">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <ImageView
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ring_preview" />

            <TextView
                android:id="@+id/value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:gravity="center"
                android:maxLines="2"
                android:padding="10dp"
                android:text="@string/widget_preview_value"
                android:textColor="@color/widget_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label"
                style="@style/NiluWidget.Label"
                android:text="@string/widget_preview_label" />

            <TextView
                android:id="@+id/caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/widget_preview_caption"
                android:textColor="@color/widget_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detail"
                style="@style/NiluWidget.Muted"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="@string/widget_preview_detail" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/nilu_widget_empty" />
</FrameLayout>
