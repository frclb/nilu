<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="widget_radius">24dp</dimen>

    <style name="NiluWidget" parent="@android:style/Theme.DeviceDefault.DayNight" />

    <style name="NiluWidget.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_brand</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NiluWidget.Muted">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
