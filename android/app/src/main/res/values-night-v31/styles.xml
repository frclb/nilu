<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: sistem açılış ekranı. Zemin uygulamanın arka planı,
         ortada lotus — iOS açılış ekranıyla aynı (tool/generate_android_assets.py). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <!-- Flutter çizene kadar ve onun arkasında görünen pencere rengi. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
