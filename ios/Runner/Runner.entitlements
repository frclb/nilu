<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  HealthKit yetkisi.

  Apple Developer hesabında da HealthKit capability açık olmalı, yoksa
  imzalama başarısız olur. Apple Watch ve diğer uygulamaların verisi
  HealthKit üzerinden geliyor: ayrı bir "giyilebilir cihaz" entegrasyonu
  gerekmiyor.
-->
<plist version="1.0">
<dict>
	<!--
	  Widget ayrı bir süreç; uygulamanın belleğine erişemiyor. Döngü özeti
	  bu grup üzerinden paylaşılıyor.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.furkan.rcperiodtracker</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!--
	  Apple ile Giriş.

	  Uygulama `SignInWithApple.getAppleIDCredential` çağırıyor
	  (`firebase_auth_datasource.dart`). Bu yetki olmadan çağrı cihazda
	  1000 hatasıyla düşüyor; simülatörde ve testte görünmüyor, ilk kez
	  TestFlight'ta ortaya çıkar.

	  Apple Developer portalında App ID üzerinde "Sign in with Apple"
	  yeteneği de açık olmalı, yoksa imzalama başarısız olur.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  Push bildirim ortamı.

	  `UIBackgroundModes` içinde `remote-notification` var ve
	  `notification_service.dart` FCM jetonu istiyor; bu anahtar olmadan
	  jeton hiç üretilmiyor ("geçerli bir aps-environment yetki anahtarı
	  bulunamadı").

	  Değer `development`: Xcode, App Store'a dışa aktarırken bunu
	  kendiliğinden `production` yapıyor. Portalda "Push Notifications"
	  yeteneği de açık olmalı.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  `com.apple.developer.healthkit.access` BİLEREK yok.

	  O yetki "Verifiable Health Records" için: hastane ve laboratuvarlardan
	  gelen klinik kayıtlar (tahlil sonucu, ilaç, aşı). Apple'ın takıma ve
	  bundle kimliğine ayrıca atamasını gerektiriyor ve imzalamayı
	  durduruyordu:

	      HealthKit Access (Verifiable Health Records) capability needs to
	      be assigned to your team and bundle identifier by Apple

	  Uygulama klinik kayıt okumuyor: regl akışı, uyku ve dinlenme nabzı
	  (bkz. `health_datasource.dart`). Bunların hepsi normal HealthKit
	  kapsamında ve yukarıdaki anahtarla karşılanıyor. Boş bir dizi hiçbir
	  klinik tip istemiyordu ama varlığı özel yetki şartını tetikliyor,
	  üstelik incelemede gereksiz soru doğuruyordu.
	-->
</dict>
</plist>
