<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  HealthKit yetkisi.

  Apple Developer hesabında da HealthKit capability açık olmalı, yoksa
  imzalama başarısız olur. Apple Watch ve diğer uygulamaların verisi
  HealthKit üzerinden geliyor: ayrı bir "giyilebilir cihaz" entegrasyonu
  gerekmiyor.
-->
<plist version="1.0">
<dict>
	<!--
	  Widget ayrı bir süreç; uygulamanın belleğine erişemiyor. Döngü özeti
	  bu grup üzerinden paylaşılıyor.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.furkan.rcperiodtracker</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!--
	  Partner davet bağlantısı (https://frclb.github.io/nilu/p/#KOD)
	  uygulamayı doğrudan açsın: Universal Link. Alan adının kökünde Apple'ın
	  doğrulama dosyası var (/.well-known/apple-app-site-association,
	  frclb/frclb.github.io deposu). Apple Developer'da App ID'de
	  "Associated Domains" açık olmalı.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:frclb.github.io</string>
	</array>
	<!--
	  Apple ile giriş (isteğe bağlı hesap ve bulut eşitleme). Apple
	  Developer'da App ID'de "Sign in with Apple" capability açık olmalı.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  `aps-environment` (push) BİLEREK yok. Uygulama push göndermiyor:
	  hatırlatıcılar cihazda planlanan yerel bildirimler. Önceden FCM jetonu
	  toplanıp sunucuya yazılıyordu ama hiçbir şey gönderilmiyordu.
	-->
	<!--
	  `com.apple.developer.healthkit.access` BİLEREK yok.

	  O yetki "Verifiable Health Records" için: hastane ve laboratuvarlardan
	  gelen klinik kayıtlar (tahlil sonucu, ilaç, aşı). Apple'ın takıma ve
	  bundle kimliğine ayrıca atamasını gerektiriyor ve imzalamayı
	  durduruyordu:

	      HealthKit Access (Verifiable Health Records) capability needs to
	      be assigned to your team and bundle identifier by Apple

	  Uygulama klinik kayıt okumuyor: yalnızca regl akışı (okuma; ayar
	  açıksa yazma; bkz. `health_datasource.dart`). Bu normal HealthKit
	  kapsamında ve yukarıdaki anahtarla karşılanıyor. Boş bir dizi hiçbir
	  klinik tip istemiyordu ama varlığı özel yetki şartını tetikliyor,
	  üstelik incelemede gereksiz soru doğuruyordu.
	-->
</dict>
</plist>
