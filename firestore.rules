rules_version = '2';

// RCApp — Cloud Firestore güvenlik kuralları
//
// Veri modeli (lib/data/datasources/remote/firestore_datasource.dart):
//   users/{uid}                -> profil, partnerId, hasPartner, fcmTokens
//   users/{uid}/logs/{dateStr} -> günlük sağlık logları (HASSAS)
//   intimacy/{uid}             -> yakınlık durumu (HASSAS)
//
// Temel ilke: kullanıcı yalnızca kendi verisine yazar. Tek istisna
// eşleştirme akışıdır (aşağıda).
//
// ⚠️ BİLİNEN AÇIK — eşleştirme geri alınamıyor.
//
// Uygulama partner bağlantısını, karşı tarafın UID'sini QR kodla paylaşarak
// kuruyor. UID pratikte bir "bearer token": UID'yi bilen herkes kendini
// partner olarak bağlayabilir. Aşağıdaki kurallar hasarı sınırlar — bağlanan
// taraf yalnızca `partnerId`/`hasPartner` alanlarına dokunabilir, log ve FCM
// token'larına erişemez.
//
// Sınırlayamadığı şey İPTAL. `isLinkedPartnerOf` istekte bulunanın KENDİ
// dokümanındaki `partnerId` alanına bakıyor; o alanı da istekte bulunan
// yazabiliyor (eşleştirme akışı buna dayanıyor). Sonuç:
//
//   1. Kullanıcı partnerinden ayrılır; `disconnectPartner` iki dokümandaki
//      bağlantıyı temizler.
//   2. Eski partner `users/{kendi}.partnerId` alanına eski UID'yi tekrar
//      yazar — kural buna izin veriyor.
//   3. `intimacy/{uid}` yeniden okunabilir hâle gelir.
//
// UID hiçbir zaman değişmediği (bkz. `UserViewModel.ensureMyId`) için eski
// partnerin elindeki kod kalıcı olarak geçerli kalıyor. Yeni bir partner
// bağlamak da eskisinin erişimini kaldırmıyor.
//
// Bunu kurallarla kapatmak mümkün değil; eşleştirme modelinin değişmesi
// gerekiyor. Önerilen: QR'a UID yerine **döndürülebilir** bir eşleştirme
// kodu koymak ve erişimi, yalnızca sahibinin yazabildiği bir
// `users/{uid}.partners` listesine bağlamak:
//
//   allow read: if request.auth.uid in
//                 get(/databases/$(database)/documents/users/$(uid)).data.partners;
//
// Bu, ayrılma anında erişimi gerçekten koparır ve karşı taraf kendini geri
// ekleyemez. Karşılığı: eşleştirme sırasında sahibin onayı gerekir
// (her iki taraf çevrimiçi ya da bir Cloud Function).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // İstek sahibinin kendi profilinde kayıtlı partneri {uid} mi?
    function isLinkedPartnerOf(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.partnerId == uid;
    }

    // Bu yazma işlemi YALNIZCA eşleştirme alanlarına mı dokunuyor?
    function touchesOnlyPairingFields() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['partnerId', 'hasPartner']);
    }

    // Doküman ilk kez oluşturuluyorsa yalnız bu alanlarla oluşturulabilir.
    function createsOnlyPairingFields() {
      return request.resource.data.keys().hasOnly(['partnerId', 'hasPartner']);
    }

    match /users/{uid} {
      // Profili yalnızca sahibi okur. Partner, karşı tarafın profiline
      // (dolayısıyla fcmTokens'a) erişemez.
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
                    || (isSignedIn() && createsOnlyPairingFields());

      allow update: if isOwner(uid)
                    || (isSignedIn() && touchesOnlyPairingFields());

      // Profil silme yalnızca sahibine ait.
      allow delete: if isOwner(uid);

      // Günlük sağlık logları hiçbir koşulda paylaşılmaz.
      match /logs/{dateStr} {
        allow read, write: if isOwner(uid);
      }
    }

    match /intimacy/{uid} {
      // Sahibi her zaman; bağlı partner yalnızca okuyabilir.
      allow read: if isOwner(uid) || isLinkedPartnerOf(uid);
      allow write: if isOwner(uid);
    }

    // Tanımlanmamış her yol kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
