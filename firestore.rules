rules_version = '2';

// RCApp — Cloud Firestore güvenlik kuralları
//
// Veri modeli (lib/data/datasources/remote/firestore_datasource.dart):
//   users/{uid}                  -> partners (tek kişi)
//   users/{uid}/logs/{dateStr}   -> ESKİ: artık yazılmıyor; yalnızca silme
//   intimacy/{uid}               -> paylaşılan yakınlık durumu (HASSAS)
//   pairingTokens/{token}        -> eşleştirme kodu → sahip UID
//   syncData/{uid}               -> bulut kopyasının üst bilgisi (HASSAS)
//   syncData/{uid}/chunks/{i}    -> bulut kopyasının parçaları (HASSAS)
//
// Kimlik her zaman bir Apple ya da Google hesabı. Hesap isteğe bağlı ama
// sunucuya yazan iki özellik de onu istiyor: partner eşleşmesi ve bulut
// eşitleme (kullanıcı açık rıza verdikten sonra, bkz.
// `firestore_sync_remote.dart`). Anonim kimlik yok; eskiden partner
// eşleşmesi onunla kuruluyordu.
//
// Temel ilke: kullanıcı yalnızca kendi verisine yazar. Erişim verme yetkisi
// yalnızca verinin sahibinde.
//
// ── Eşleştirme modeli ──
//
// Önceki model UID'yi QR ile paylaşıyordu ve **iptal edilemiyordu**. UID
// pratikte kalıcı bir bearer token'dı: `isLinkedPartnerOf` istekte bulunanın
// kendi dokümanındaki `partnerId` alanına bakıyor, o alanı da istekte
// bulunan yazabiliyordu. Sonuç:
//
//   1. Kullanıcı partnerinden ayrılır, bağlantı iki tarafta da temizlenir.
//   2. Eski partner `users/{kendi}.partnerId` alanına eski UID'yi yeniden
//      yazar — kural buna izin veriyordu.
//   3. Erişim geri gelir. UID hiç değişmediği için elindeki kod kalıcı
//      olarak geçerliydi; yeni bir partner bağlamak da eskisini atmıyordu.
//
// Şimdi erişim `users/{uid}.partners` listesine bağlı ve o listeye
// **yalnızca sahibi** yazabiliyor. Ayrılma anında sahip listeden çıkarır ve
// karşı taraf kendini geri ekleyemez.
//
// QR'da UID değil döndürülebilir bir kod var (bkz. `PairingToken`). Kod
// yenilendiğinde daha önce paylaşılmış bütün QR'lar geçersiz olur.
//
// Eşleştirme akışı:
//   1. Sahip bir kod üretir; `pairingTokens/{token}` sahibin UID'sini tutar.
//   2. Karşı taraf kodu okur, `pairingTokens/{token}/requests/{kendiUid}`
//      altına bir istek yazar.
//   3. Sahip isteği görür ve onaylarsa kendi `partners` listesine ekler.
//
// Davet bağlantısı aynı akış; yalnızca kod tek kullanımlık ve bir saatlik
// (aşağıda `pairingTokens`).
//
// Üçüncü adım sahibin onayını gerektiriyor — bedeli bu. Karşılığında erişim
// gerçekten geri alınabiliyor.

service cloud.firestore {
  match /databases/{database}/documents {

    // Apple ya da Google hesabıyla oturum. Anonim oturum (Firebase'de
    // kapalı, eski sürümlerden kalmış olabilir) hiçbir şeye erişemez.
    //
    // `sign_in_provider` değil `identities`: Firebase hesabın hangi
    // sağlayıcılarla doğrulandığını orada tutuyor.
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.get('identities', {})
             .keys().hasAny(['apple.com', 'google.com']);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // İstekte bulunan, {uid}'nin **kendi yazdığı** partner listesinde mi?
    //
    // Kritik fark: bakılan liste veri sahibinin dokümanında ve o dokümana
    // yalnızca sahibi yazabiliyor. İstekte bulunan kendini bu listeye
    // ekleyemez.
    function isApprovedPartnerOf(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.auth.uid in
             get(/databases/$(database)/documents/users/$(uid))
               .data.get('partners', []);
    }

    // Partner **yalnızca kendini** sahibin listesinden çıkarabilir: başka
    // hiçbir alan değişmemeli ve yeni liste eskisinden yalnızca istekte
    // bulunanın çıkarılmış hâli olmalı. Önceden partner tarafındaki
    // "Bağlantıyı Kes" sunucuda hiçbir şey değiştirmiyordu.
    function isSelfRemoval(uid) {
      let before = resource.data.get('partners', []);
      let after = request.resource.data.get('partners', []);
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['partners'])
        && after == before.removeAll([request.auth.uid]);
    }

    match /users/{uid} {
      // Dokümanı yalnızca sahibi okur.
      allow read: if isOwner(uid);

      allow create, delete: if isOwner(uid);
      allow update: if isOwner(uid) || isSelfRemoval(uid);

      // Eski sürümlerin yazdığı loglar: artık yazılmıyor, sahibi silebilsin.
      match /logs/{dateStr} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }
    }

    // Bulut eşitleme: yalnızca hesabın sahibi okur ve yazar. Partner dahil
    // başka hiç kimse — onaylı partner yalnızca `intimacy`'yi görüyor.
    match /syncData/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['version', 'hash', 'chunkCount', 'schema', 'disabled', 'updatedAt'])
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 0
        && request.resource.data.chunkCount <= 200;

      match /chunks/{index} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['index', 'data'])
          && request.resource.data.data is string;
      }
    }

    match /intimacy/{uid} {
      // Sahibi her zaman; onaylı partner yalnızca okuyabilir.
      allow read: if isOwner(uid) || isApprovedPartnerOf(uid);
      allow write: if isOwner(uid);
    }

    match /pairingTokens/{token} {
      // İki tür kod var:
      //
      //   - QR kodu: `{ownerUid}`. Sahip yenileyene kadar geçerli.
      //   - Davet bağlantısı: `{ownerUid, oneTime: true, createdAt}`. Bir
      //     saat geçerli ve **tek kullanımlık**: ilk açan kişi kendini
      //     `usedBy` alanına yazıyor; bundan sonra başka hiç kimse (aynı kişi
      //     ikinci kez de) o bağlantıyla istek bırakamıyor.
      //
      // Kodun kendisi sırdır: kodu bilen sahibin UID'sini çözebilir.
      // Kodu bilmeyen bu dokümanın adını da bilemez, listeleme kapalı.
      allow get: if isSignedIn();
      allow list: if false;

      // Kodu yalnızca sahibi oluşturur ve siler. Silmek kodu iptal eder.
      // Davetin saati sunucunun saati: istemci süreyi uzatamaz.
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && (request.resource.data.keys().hasOnly(['ownerUid'])
                        || (request.resource.data.keys()
                              .hasOnly(['ownerUid', 'oneTime', 'createdAt'])
                            && request.resource.data.oneTime == true
                            && request.resource.data.createdAt == request.time));
      allow delete: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;

      // Davet bağlantısını kullanmak: bir kez, süresi dolmadan, sahibi
      // dışında biri, yalnızca kendi adına.
      allow update: if isSignedIn()
                    && resource.data.get('oneTime', false) == true
                    && !('usedBy' in resource.data)
                    && resource.data.ownerUid != request.auth.uid
                    && request.time < resource.data.createdAt + duration.value(1, 'h')
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['usedBy'])
                    && request.resource.data.usedBy == request.auth.uid;

      // Eşleştirme isteği. Karşı taraf yalnızca kendi adına istek yazabilir;
      // davet bağlantısında ancak bağlantıyı kendisi kullandıysa (aynı
      // yazımda ya da önce).
      match /requests/{requesterUid} {
        allow create: if isOwner(requesterUid)
          && (getAfter(/databases/$(database)/documents/pairingTokens/$(token))
                .data.get('oneTime', false) == false
              || getAfter(/databases/$(database)/documents/pairingTokens/$(token))
                   .data.get('usedBy', '') == requesterUid);

        // Sahip istekleri okur ve işi bitince siler; istekte bulunan da
        // kendi isteğini geri çekebilir.
        allow read, delete: if isOwner(requesterUid)
                           || (isSignedIn()
                               && get(/databases/$(database)/documents/pairingTokens/$(token))
                                    .data.ownerUid == request.auth.uid);
        allow update: if false;
      }
    }

    // Tanımlanmamış her yol kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
