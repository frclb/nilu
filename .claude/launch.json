{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rcapp-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8080",
        "--web-hostname",
        "127.0.0.1"
      ],
      "port": 8080,
      "url": "http://127.0.0.1:8080"
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "build/site"],
      "port": 8765
    }
  ]
}
